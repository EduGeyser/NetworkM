{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keeps actions pinned by commit, with the full version in the trailing comment
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  // config:recommended allows only LTS Java releases; the build follows the newest release
  ignorePresets: ['workarounds:javaLTSVersions'],
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: ['github-actions'],
    },
    {
      // The github-actions manager reads the node-version input itself (depType uses-with), so no
      // custom manager is needed. A runtime bump can break the build, so it does not hold up the
      // action updates.
      groupName: 'CI runtimes',
      matchManagers: ['github-actions'],
      matchDepTypes: ['uses-with'],
    },
    {
      groupName: 'Gradle dependencies',
      matchManagers: ['gradle', 'custom.regex'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      // Only the nmcp publishing task loads these; they never reach the transport artifacts
      groupName: 'Publisher libraries',
      matchPackageNames: [
        'com.squareup.okhttp3:okhttp',
        'com.squareup.okio:okio',
        'io.github.pdvrieze.xmlutil:*',
        'org.jetbrains.kotlin:kotlin-stdlib',
        'org.jetbrains:annotations',
      ],
    },
  ],
  customManagers: [
    {
      // The newest JDK, which the Gradle toolchains and the CI read; its own pull request, as a JDK
      // release can break the build. semver-partial keeps the major-only form.
      customType: 'regex',
      managerFilePatterns: ['/^gradle\\.properties$/'],
      matchStrings: ['newestJavaVersion=(?<currentValue>\\d+)'],
      depNameTemplate: 'java-jdk',
      datasourceTemplate: 'java-version',
      versioningTemplate: 'semver-partial',
    },
    {
      // The root build hands this catalog version to the JaCoCo plugin, so no library references it
      customType: 'regex',
      managerFilePatterns: ['/(^|/)gradle/libs\\.versions\\.toml$/'],
      matchStrings: ['jacoco ="(?<currentValue>[^"]+)"'],
      depNameTemplate: 'org.jacoco:org.jacoco.agent',
      datasourceTemplate: 'maven',
    },
  ],
}
