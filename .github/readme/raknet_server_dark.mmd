---
config:
  layout: elk
  theme: redux-dark
---
flowchart LR
    Network(("Network socket"))
    Parent["<b>RakServerChannel</b><br><i>UDP bind, offline handshake, routing by sender</i>"]

 subgraph InternalPipeline["<b>RakNet internal pipeline</b><br>(RakChildChannel)"]
    ChildDatagramHandler["<b>RakChildDatagramHandler</b><br><i>Addresses outbound datagrams</i>"]
    DatagramCodec["<b>RakDatagramCodec</b><br><i>Encodes and decodes datagrams</i>"]
    AckHandler["<b>RakAcknowledgeHandler</b><br><i>Applies received ACKs and NACKs</i>"]
    SessionCodec["<b>RakSessionCodec</b><br><i>Reliability, ordering, split messages</i>"]
 end
 subgraph UserPipeline["<b>User ChannelPipeline</b><br>(RakChildChannel)"]
    UserLogic["<b>User Handlers</b><br><i>Application logic<br>(e.g. Bedrock protocol)</i>"]
 end

    %% Inbound
    Network == Inbound <i>UDP datagram</i> ==> Parent
    Parent == <i>ByteBuf</i> ==> DatagramCodec
    DatagramCodec == ACK, NACK ==> AckHandler
    DatagramCodec == <i>RakDatagramPacket</i> ==> SessionCodec
    SessionCodec == <i>RakMessage</i> ==> UserLogic
    AckHandler -. Acknowledged ranges .-> SessionCodec

    %% Outbound
    UserLogic == <i>ByteBuf</i>, <i>RakMessage</i> ==> SessionCodec
    SessionCodec == <i>RakDatagramPacket</i>, ACK, NACK ==> DatagramCodec
    DatagramCodec == <i>ByteBuf</i> ==> ChildDatagramHandler
    ChildDatagramHandler == <i>DatagramPacket</i> ==> Parent
    Parent == Outbound <i>UDP datagram</i> ==> Network

    %% Styling
    ChildDatagramHandler:::shared
    DatagramCodec:::shared
    AckHandler:::shared
    SessionCodec:::shared

    classDef shared fill:#9b59b6,stroke:#333,stroke-width:2px

    linkStyle 0,1,2,3,4 stroke:#2ecc71,stroke-width:4px,color:#2ecc71
    linkStyle 5 stroke:#2ecc71,stroke-width:2px,color:#2ecc71
    linkStyle 6,7,8,9,10 stroke:#3498db,stroke-width:4px,color:#3498db
