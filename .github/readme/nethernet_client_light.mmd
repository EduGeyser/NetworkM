---
config:
  layout: elk
  theme: redux
---
flowchart LR
    Server(("NetherNet server"))

 subgraph TransportLayer["<b>NetherNet Transport</b>"]
    Signaling["<b>NetherNetClientSignaling</b><br><i>HTTP, Xbox RPC or LAN</i>"]
    ClientChannel["<b>NetherNetClientChannel</b><br><i>Signs the offer with its ClientIdentity, checks the answer with its ServerTrust</i>"]
  subgraph Engine["<b>NetherNetEngine</b><br><i>WebRtcEngine: libwebrtc through webrtc-java</i>"]
    Peer["<b>Peer</b><br><i>One per attempt</i>"]
    Reliable["<b>ReliableDataChannel</b>"]
    Unreliable["<b>UnreliableDataChannel</b>"]
  end
 end
 subgraph UserPipeline["<b>User ChannelPipeline</b>"]
    UserLogic["<b>User Handlers</b><br><i>Application Logic</i>"]
 end

    %% Signaling
    Server <-. Offer, answer, candidates .-> Signaling
    Signaling <-. Offer, answer, candidates .-> ClientChannel
    Peer <-. Creates, opens both channels .- ClientChannel

    %% Data
    Server <== DTLS and SCTP over UDP ==> Peer
    Peer <== Segments ==> Reliable
    Peer <== Segments ==> Unreliable
    Reliable <== Segments ==> ClientChannel
    Unreliable <== Segments ==> ClientChannel
    ClientChannel <== <i>ByteBuf</i>, <i>NetherNetPacket</i> ==> UserLogic

    %% Styling
    Signaling:::shared
    ClientChannel:::shared
    Peer:::shared
    Reliable:::shared
    Unreliable:::shared

    classDef shared fill:#e67e22,stroke:#333,stroke-width:2px

    linkStyle 0,1,2 stroke:#9b59b6,stroke-width:2px,color:#9b59b6
    linkStyle 3,4,5,6,7,8 stroke:#2ecc71,stroke-width:4px,color:#2ecc71
