---
config:
  layout: elk
  theme: redux
---
flowchart LR
    Network(("Network socket"))

 subgraph InternalPipeline["<b>RakNet internal pipeline</b><br>(parent DatagramChannel)"]
    ProxyRoute["<b>RakClientProxyRouteHandler</b><br><i>Unwraps the server's datagrams, addresses outbound ones</i>"]
    DatagramCodec["<b>RakDatagramCodec</b><br><i>Encodes and decodes datagrams</i>"]
    AckHandler["<b>RakAcknowledgeHandler</b><br><i>Applies received ACKs and NACKs</i>"]
    SessionCodec["<b>RakSessionCodec</b><br><i>Reliability, ordering, split messages</i>"]
 end
 subgraph UserPipeline["<b>User ChannelPipeline</b><br>(RakClientChannel)"]
    UserLogic["<b>User Handlers</b><br><i>Application logic</i>"]
 end

    %% Inbound
    Network == Inbound <i>UDP datagram</i> ==> ProxyRoute
    ProxyRoute == <i>ByteBuf</i> ==> DatagramCodec
    DatagramCodec == ACK, NACK ==> AckHandler
    DatagramCodec == <i>RakDatagramPacket</i> ==> SessionCodec
    SessionCodec == <i>RakMessage</i> ==> UserLogic
    AckHandler -. Acknowledged ranges .-> SessionCodec

    %% Outbound
    UserLogic == <i>ByteBuf</i>, <i>RakMessage</i> ==> SessionCodec
    SessionCodec == <i>RakDatagramPacket</i>, ACK, NACK ==> DatagramCodec
    DatagramCodec == <i>ByteBuf</i> ==> ProxyRoute
    ProxyRoute == Outbound <i>UDP datagram</i> ==> Network

    %% Styling
    ProxyRoute:::shared
    DatagramCodec:::shared
    AckHandler:::shared
    SessionCodec:::shared

